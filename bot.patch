+async def message_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    if not update.message or not update.effective_chat or not context.application:
+        return
+
+    state = load_state()
+    raw_chat_id = str(update.effective_chat.id)
+    chat = llm_chat_state(state, update.effective_chat.id)
+
+    changed = await process_chat_llm(
+        application=context.application,
+        raw_chat_id=raw_chat_id,
+        chat=chat,
+        force=True,
+    )
+    if not changed:
+        await update.message.reply_text("Пока нет новых сообщений для контекста. Напишите что-нибудь в чат и попробуйте снова.")
+        return
+
+    save_state(state)
