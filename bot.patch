 def parse_vars(tokens: list[str]) -> dict[str, Any]:
     result: dict[str, Any] = {}
     for token in tokens:
         if "=" not in token:
             continue
         key, raw_value = token.split("=", 1)
         key = key.strip()
         raw_value = raw_value.strip()
         if not key:
             continue

         try:
             result[key] = int(raw_value)
         except ValueError:
             result[key] = raw_value
