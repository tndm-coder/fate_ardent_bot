+async def collect_message(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    del context
+    if not update.message or not update.effective_chat:
+        return
+
+    text = (update.message.text or "").strip()
+    if not text or text.startswith("/"):
+        return
+
+    state = load_state()
+    chat = llm_chat_state(state, update.effective_chat.id)
+    chat["pending"].append(
+        {
+            "author": user_display_name(update.effective_user),
+            "text": text,
+            "at": datetime.now().isoformat(timespec="seconds"),
+        }
+    )
+    chat["last_activity_at"] = datetime.now().isoformat(timespec="seconds")
+    trim_pending(chat)
+    save_state(state)
+
+
+async def process_chat_llm(
+    *,
+    application: Application,
+    raw_chat_id: str,
+    chat: dict[str, Any],
+    force: bool,
+) -> bool:
+    pending = list(chat.get("pending", []))
+    if not pending:
+        return False
+
+    if not force and random.random() >= LLM_REPLY_PROBABILITY:
+        chat["skipped_count"] = int(chat.get("skipped_count", 0)) + 1
+        chat["pending"] = []
+        return True
+
+    context_messages = pending[-MAX_CONTEXT_MESSAGES:]
+    try:
+        reply, provider = await generate_llm_reply(context_messages)
+    except RuntimeError as exc:
+        LOGGER.warning("LLM failed for chat %s: %s", raw_chat_id, exc)
+        return False
+
+    try:
+        await application.bot.send_message(chat_id=int(raw_chat_id), text=reply)
+    except Exception as exc:  # noqa: BLE001
+        LOGGER.warning("Failed to send LLM reply to chat %s: %s", raw_chat_id, exc)
+        return False
+
+    LOGGER.info("LLM replied in chat %s via %s", raw_chat_id, provider)
+    chat["responded_count"] = int(chat.get("responded_count", 0)) + 1
+    chat["last_reply_at"] = datetime.now().isoformat(timespec="seconds")
+    chat["pending"] = []
+    return True
+
+
+async def llm_tick(context: ContextTypes.DEFAULT_TYPE) -> None:
+    if not context.application:
+        return
+
+    state = load_state()
+    chats_payload = state.get("llm", {}).get("chats", {})
+    changed = False
+
+    for raw_chat_id, chat in chats_payload.items():
+        changed = await process_chat_llm(
+            application=context.application,
+            raw_chat_id=raw_chat_id,
+            chat=chat,
+            force=False,
+        ) or changed
+
+    if changed:
+        save_state(state)
+
+
+async def message_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    if not update.message or not update.effective_chat or not context.application:
+        return
+
+    state = load_state()
+    raw_chat_id = str(update.effective_chat.id)
+    chat = llm_chat_state(state, update.effective_chat.id)
+
+    changed = await process_chat_llm(
+        application=context.application,
+        raw_chat_id=raw_chat_id,
+        chat=chat,
+        force=True,
+    )
+    if not changed:
+        await update.message.reply_text("Пока нет новых сообщений для контекста. Напишите что-нибудь в чат и попробуйте снова.")
+        return
+
+    save_state(state)
+
+
